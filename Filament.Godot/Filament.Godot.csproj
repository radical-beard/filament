<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 to match the Godot 4.6 .NET runtime, so the framework can be
         loaded by a real Godot game (a net10 lib could not). -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Filament</RootNamespace>
    <!-- Referenced libraries must ship beside a dynamically-loaded Godot game. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GodotSharp" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Filament.Abstractions\Filament.Abstractions.csproj" />
    <ProjectReference Include="..\Filament.Core\Filament.Core.csproj" />
    <ProjectReference Include="..\Filament.SourceGen\Filament.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
