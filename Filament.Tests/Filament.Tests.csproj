<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <!-- Manual-compile harness for analyzer/generator tests. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <!-- Generated converters in this assembly reference MoonSharp types. -->
    <PackageReference Include="MoonSharp" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Filament.Abstractions\Filament.Abstractions.csproj" />
    <ProjectReference Include="..\Filament.Core\Filament.Core.csproj" />
    <ProjectReference Include="..\Filament.Config\Filament.Config.csproj" />
    <!-- Plug in as analyzer/generator AND reference the assembly (so the sample
         [Scriptable] types get converters generated, and tests can `new ScriptableAnalyzer()`). -->
    <ProjectReference Include="..\Filament.SourceGen\Filament.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
