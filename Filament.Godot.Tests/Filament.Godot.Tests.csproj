<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10 so the test host runs on the installed runtime; it references the
         net8 Filament.Godot via roll-forward. Tests use only Godot value structs
         (Vector/Color), so no engine is required. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageReference Include="GodotSharp" Version="4.6.0" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Filament.Abstractions\Filament.Abstractions.csproj" />
    <ProjectReference Include="..\Filament.Core\Filament.Core.csproj" />
    <ProjectReference Include="..\Filament.Godot\Filament.Godot.csproj" />
    <ProjectReference Include="..\Filament.SourceGen\Filament.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
