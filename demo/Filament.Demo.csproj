<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Filament.Demo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated converters in this assembly reference MoonSharp types. -->
    <PackageReference Include="MoonSharp" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Filament.Abstractions\Filament.Abstractions.csproj" />
    <ProjectReference Include="..\Filament.Core\Filament.Core.csproj" />
    <ProjectReference Include="..\Filament.SourceGen\Filament.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Demo Lua scripts copied next to the binary so the registry can watch them. -->
  <ItemGroup>
    <None Include="lua\**\*.lua" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
