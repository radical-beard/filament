<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Godot-free, net8-consumable. The TOML world-config model + diff; the
         Node-application/factory layer lives in Filament.Godot (built with the game). -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Filament.Config</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="0.19.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Filament.Abstractions\Filament.Abstractions.csproj" />
  </ItemGroup>

</Project>
